BINARY        = .build/release/superlinear
INSTALL_PATH  = $(HOME)/.local/bin/superlinear
LABEL         = com.armcknight.superlinear
LOG           = $(HOME)/.local/share/superlinear/daemon.log
STATE         = $(HOME)/.local/share/superlinear/state.json
LOGS_DIR      = $(HOME)/.local/share/superlinear/logs
CONFIG        = $(HOME)/.config/superlinear/config.json
VERSION_FILE  = Sources/superlinear/Version.swift
VRSN_KEY      = version

.DEFAULT_GOAL = help
.PHONY: help init build test install load unload reload logs config status reset patch minor major deploy deploy-beta

# Targets document themselves with a `## name: description` line above them,
# which is the only thing this prints. Only the first colon separates the two,
# so a description may contain further colons.
## help: list these targets
help:
	@awk '/^## /{ t = substr($$0, 4); c = index(t, ":"); printf "  make %-12s %s\n", substr(t, 1, c - 1), substr(t, c + 2) }' $(MAKEFILE_LIST)

# Both taps are third-party, and Homebrew refuses to load formulae or casks from
# an untrusted tap. `brew bundle` aborts on the first one it meets and installs
# nothing at all, including the entries after it, so trust precedes the bundle.
# Both commands are idempotent.
#
# `work start` runs this in every new worktree, so it has to stay that way.
## init: trust the taps and install everything in the Brewfile
init:
	@command -v brew >/dev/null 2>&1 || { echo "Homebrew is required: https://brew.sh"; exit 1; }
	brew trust --tap dorkitude/linctl
	brew trust --tap armcknight/tools
	brew bundle --file=Brewfile

## build: build the release binary
build:
	swift build -c release

## test: run the unit tests
test:
	swift test

## install: build, then copy the binary into ~/.local/bin
install: build
	mkdir -p $(HOME)/.local/bin
	cp $(BINARY) $(INSTALL_PATH)

# The launch agent is generated by the binary rather than checked in, because
# launchd expands neither `~` nor `$$HOME` inside a plist: every path must be
# absolute, so one file cannot serve every machine. Generating it at install
# time also points the agent at whichever binary registered it.
## load: install, then register and start the launch agent
load: install
	$(INSTALL_PATH) install

## unload: stop the launch agent and remove it
unload:
	-$(INSTALL_PATH) uninstall

## reload: unload, then load
reload: unload load

## logs: follow the daemon log
logs:
	tail -f $(LOG)

## config: create the example config if absent, then open it
config:
	@if [ ! -f $(CONFIG) ]; then \
		echo "Creating example config at $(CONFIG)"; \
		mkdir -p $(HOME)/.config/superlinear; \
		echo '{\n  "workspaces": [\n    {\n      "name": "my-workspace",\n      "apiKey": "lin_api_YOUR_KEY_HERE",\n      "repoPath": "~/Code/my-repo",\n      "teamIds": [],\n      "pollIntervalSeconds": 60\n    }\n  ]\n}' > $(CONFIG); \
	else \
		echo "Config already exists at $(CONFIG)"; \
	fi
	$${EDITOR:-emacs} $(CONFIG)

## status: show whether launchd is running the daemon
status:
	@launchctl list | grep $(LABEL) || echo "Not running"

## reset: clear state and logs so every issue is reprocessed
reset:
	rm -f $(STATE)
	rm -f $(LOGS_DIR)/*.log
	-tmux list-sessions -F '#{session_name}' 2>/dev/null | grep '^superlinear_' | xargs -I{} tmux kill-session -t {}
	@echo "State, logs, and tmux sessions cleared. Daemon will reprocess all issues on next poll."

## patch: bump the patch version (x.y.Z) and commit (also: minor, major)
patch:
	vrsn patch -f $(VERSION_FILE) -k $(VRSN_KEY) --commit

minor:
	vrsn minor -f $(VERSION_FILE) -k $(VRSN_KEY) --commit

major:
	vrsn major -f $(VERSION_FILE) -k $(VRSN_KEY) --commit

## deploy: tag and push the current version, shipping the stable cask
deploy:
	@VERSION=$$(vrsn -r -f $(VERSION_FILE) -k $(VRSN_KEY)) && \
	echo "Tagging $$VERSION..." && \
	git tag -a "$$VERSION" -m "$$VERSION" && \
	git push && git push origin "$$VERSION"

## deploy-beta: same, but cut a release candidate
deploy-beta:
	@VERSION=$$(vrsn -r -f $(VERSION_FILE) -k $(VRSN_KEY)) && \
	echo "Tagging $$VERSION-rc.1..." && \
	git tag -a "$$VERSION-rc.1" -m "$$VERSION-rc.1" && \
	git push && git push origin "$$VERSION-rc.1"
